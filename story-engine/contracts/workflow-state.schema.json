{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedsofthethrone.local/contracts/workflow-state.schema.json",
  "title": "Story Engine Workflow State",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflowId", "taskId", "depth", "phase", "updatedAt", "sources"],
  "properties": {
    "workflowId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "depth": { "type": "string", "minLength": 1 },
    "phase": {
      "enum": ["scope", "retrieve", "analyze", "develop", "evaluate", "author_gate", "integrate", "complete", "blocked"]
    },
    "updatedAt": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "gate": { "$ref": "#/$defs/authorityGate" }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "heading": { "type": "string" },
        "status": { "enum": ["established", "working", "proposed", "unresolved", "rejected"] },
        "checksum": { "type": "string" }
      }
    },
    "authorityGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "state"],
      "properties": {
        "id": { "type": "string" },
        "prompt": { "type": "string" },
        "state": { "enum": ["waiting", "accepted", "rejected"] },
        "acceptedValue": { "type": "string" },
        "decidedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
